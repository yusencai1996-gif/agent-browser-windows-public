{
  "manifest_version": 3,
  "name": "Agent 浏览器",
  "version": "0.8.1",
  "description": "Agent 浏览器：独立浏览器环境、任务控制与本机 Agent 接入。",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Agent 浏览器"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "alarms",
    "offscreen",
    "downloads",
    "notifications",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "brand/avatar.png",
    "48": "brand/avatar.png",
    "128": "brand/avatar.png"
  },
  "version_name": "0.8.1-alpha.1"
}
